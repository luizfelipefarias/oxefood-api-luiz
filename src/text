export const listarTROQUE_AQUI_POR_ENTIDADE_FILHA_PLURAL = () => axios.get(API_URL);
export const obterTROQUE_AQUI_POR_ENTIDADE_FILHA = (id) => axios.get(`${API_URL}/${id}`);
export const salvarTROQUE_AQUI_POR_ENTIDADE_FILHA = (data) => axios.post(API_URL, data);
export const atualizarTROQUE_AQUI_POR_ENTIDADE_FILHA = (id, data) => axios.put(`${API_URL}/${id}`, data);
export const excluirTROQUE_AQUI_POR_ENTIDADE_FILHA = (id) => axios.delete(`${API_URL}/${id}`);
```


### 3. Página React da entidade filha

```javascript
import React, { useEffect, useState } from "react";
import {
  listarTROQUE_AQUI_POR_ENTIDADE_FILHA_PLURAL,
  salvarTROQUE_AQUI_POR_ENTIDADE_FILHA,
  atualizarTROQUE_AQUI_POR_ENTIDADE_FILHA,
  excluirTROQUE_AQUI_POR_ENTIDADE_FILHA
} from "../services/TROQUE_AQUI_POR_ENTIDADE_FILHA_MINUSCULO_Service";

import { listarTROQUE_AQUI_POR_ENTIDADE_PAI_PLURAL } from "../services/TROQUE_AQUI_POR_ENTIDADE_PAI_MINUSCULO_Service";

function TROQUE_AQUI_POR_ENTIDADE_FILHA_Page() {
  const [itens, setItens] = useState([]);
  const [pais, setPais] = useState([]);
  const [form, setForm] = useState({
    id: null,
    nome: "",
    quantidade: "",
    valor: "",
    dataCadastro: "",
    TROQUE_AQUI_POR_ENTIDADE_PAI_MINUSCULO: ""
  });

  useEffect(() => { carregar(); }, []);

  const carregar = async () => {
    const [resFilho, resPai] = await Promise.all([
      listarTROQUE_AQUI_POR_ENTIDADE_FILHA_PLURAL(),
      listarTROQUE_AQUI_POR_ENTIDADE_PAI_PLURAL()
    ]);
    setItens(resFilho.data);
    setPais(resPai.data);
  };

  const handleChange = (e) => {
    const { name, value } = e.target;
    setForm({ ...form, [name]: value });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const dados = { ...form, TROQUE_AQUI_POR_ENTIDADE_PAI_MINUSCULO: { id: Number(form.TROQUE_AQUI_POR_ENTIDADE_PAI_MINUSCULO) } };
    if (form.id) await atualizarTROQUE_AQUI_POR_ENTIDADE_FILHA(form.id, dados);
    else await salvarTROQUE_AQUI_POR_ENTIDADE_FILHA(dados);

    setForm({ id: null, nome: "", quantidade: "", valor: "", dataCadastro: "", TROQUE_AQUI_POR_ENTIDADE_PAI_MINUSCULO: "" });
    carregar();
  };

  return (
    <div>
      <h1>Gerenciar TROQUE_AQUI_POR_ENTIDADE_FILHA_PLURAL</h1>
      {/* Form e tabela genéricos */}
    </div>
  );
}

export default TROQUE_AQUI_POR_ENTIDADE_FILHA_Page;

